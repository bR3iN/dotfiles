// Default `us` keymap with custom overrides
xkb_keymap {
    xkb_keycodes { include "evdev+aliases(qwerty)" };
    xkb_types { include "complete" };
    xkb_compatibility { include "complete" };

    xkb_symbols {
        include "pc+us+inet(evdev)"
        // Have `Print Screen" become a second windows key (thinkpad motivated).
        include "altwin(prtsc_rwin)"

        // Caps as the compose key with caps lock moving to `Shift+Caps`.
        replace key <CAPS> {
            type= "TWO_LEVEL",
            symbols= [ Multi_key, Caps_Lock ]
        };

        // Don't have the caps key set the lock bit
        modifier_map None { Caps_Lock };
    };

    xkb_geometry { include "pc(pc105)" };
};

// vim: ft=xkb
