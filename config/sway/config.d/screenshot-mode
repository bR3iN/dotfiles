set $scr-mode-name "Screenshot [o]utput [a]ctive [s]elected (uppercase to save)"

bindsym $mod+Control+p mode $scr-mode-name

mode $scr-mode-name {
    bindsym o       mode "default"; exec wlr-screenshot --clipboard
    bindsym Shift+o mode "default"; exec wlr-screenshot
    bindsym a       mode "default"; exec wlr-screenshot --active-window --clipboard
    bindsym Shift+a mode "default"; exec wlr-screenshot --active-window
    bindsym s       mode "default"; exec wlr-screenshot --select --clipboard
    bindsym Shift+s mode "default"; exec wlr-screenshot --select

    # Return to default mode
    bindsym q mode "default"
    bindsym Escape mode "default"
    bindsym Control+bracketleft mode "default"
}
